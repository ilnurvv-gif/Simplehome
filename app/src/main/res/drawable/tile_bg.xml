<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle">
        <solid android:color="#55FFFFFF" /><stroke android:width="2dp" android:color="#E6FFFFFF" /><corners android:radius="18dp" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle">
        <solid android:color="#44FFFFFF" /><corners android:radius="18dp" /></shape></item>
    <item><shape android:shape="rectangle">
        <solid android:color="#1FFFFFFF" /><corners android:radius="18dp" /></shape></item>
</selector>
